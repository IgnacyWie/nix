# Copy to .env on eta and fill secret values from Vaultwarden or the Bootstrap
# Secret Set. Do not commit .env, generated secrets, SMTP credentials, or PEM
# private keys.

PROBO_TRAEFIK_HOST=probo.mac.wie.dev
PROBO_VERSION=latest

PROBOD_BASE_URL=https://probo.mac.wie.dev
PROBOD_ENCRYPTION_KEY=set-me
PROBOD_AUTH_COOKIE_SECRET=set-me
PROBOD_AUTH_PASSWORD_PEPPER=set-me
PROBOD_TRUST_AUTH_TOKEN_SECRET=set-me
PROBOD_OAUTH2_SERVER_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nset-me\n-----END PRIVATE KEY-----"

PROBOD_PG_ROOT_PASSWORD=set-me
PROBOD_PG_USERNAME=probod
PROBOD_PG_PASSWORD=set-me
PROBOD_PG_DATABASE=probod
PROBOD_PG_POOL_SIZE=20
PROBOD_PG_SHARED_BUFFERS=1GB
PROBOD_PG_MAX_CONNECTIONS=100

PROBOD_AWS_REGION=us-east-1
PROBOD_AWS_BUCKET=probod

PROBOD_SMTP_ADDR=smtp.example.com:587
PROBOD_SMTP_USER=set-me
PROBOD_SMTP_PASSWORD=set-me
PROBOD_SMTP_TLS_REQUIRED=true
PROBOD_MAILER_SENDER_NAME=Probo
PROBOD_MAILER_SENDER_EMAIL=no-reply@example.com
